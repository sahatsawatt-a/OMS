# Base URL for the backend API (leave as /api to use the Vite dev proxy)
VITE_API_BASE_URL=/api
# Stripe publishable key (safe to expose in the browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Base URL put in table QR codes. Set to your LAN address (e.g. http://192.168.1.20:5180)
# so a phone on the same Wi-Fi can open it. Defaults to the address the staff page is on.
VITE_PUBLIC_BASE_URL=
