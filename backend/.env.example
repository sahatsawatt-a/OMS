APP_ENV=development
# SQLAlchemy URL for MySQL (matches docker-compose.yml defaults)
DATABASE_URL=mysql+pymysql://oms:oms@localhost:3306/oms
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5180
# Stripe secret key and webhook signing secret (never commit real values)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
