APP_ENV=development
# SQLAlchemy URL for MySQL (matches docker-compose.yml defaults)
DATABASE_URL=mysql+pymysql://oms:oms@localhost:3306/oms
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5180
# Stripe secret key and webhook signing secret (never commit real values)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Shared key for the staff and admin screens (X-Staff-Key); empty locks them
STAFF_API_KEY=change-me
# Optional second key used only by automated browser checks
BROWSER_CHECK_KEY=
# Demo extras: sample-data reset, simulated card payments when Stripe has no keys
DEMO_MODE=true
