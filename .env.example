# Host ports used by docker compose (change if they clash with something else)
MYSQL_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=5180

# MySQL credentials for the local dev database
MYSQL_DATABASE=oms
MYSQL_USER=oms
MYSQL_PASSWORD=oms
MYSQL_ROOT_PASSWORD=root

# Optional public tunnel: docker compose --profile tunnel up -d
NGROK_AUTHTOKEN=
NGROK_URL=your-subdomain.ngrok-free.dev

# Stripe sandbox keys (https://dashboard.stripe.com/test/apikeys). Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Host port for the production build served through the tunnel
WEB_PORT=5181
